NODE_ENV=development
HOST=0.0.0.0
PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
DATABASE_URL=
ADMIN_SESSION_COOKIE=mankaleshwar_admin_session
ADMIN_SESSION_DAYS=7
# Used only by the one-time admin provisioning command. Never commit real values.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Backblaze B2 S3-compatible API: use the endpoint and region shown in B2 bucket details.
B2_ENDPOINT=
B2_REGION=
B2_BUCKET=
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_SIGNED_URL_TTL_SECONDS=900

# Browser Web Push (generate VAPID keys; configure all three together)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

MAX_MEDIA_UPLOAD_BYTES=25000000
